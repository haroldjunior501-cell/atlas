PORT=4000
ATLAS_DEV_USER=harold
NEXT_PUBLIC_ATLAS_GATEWAY_URL=http://localhost:4000
EXPO_PUBLIC_ATLAS_GATEWAY_URL=http://localhost:4000

# PostgreSQL. When set, organizations and accounts live in this database.
# Empty: Azure Blob if AZURE_STORAGE_CONNECTION_STRING is set, otherwise ./data.
DATABASE_URL=
AZURE_STORAGE_CONNECTION_STRING=
ATLAS_STATE_DIR=data

# Mootion text-to-video. Leave the token empty until a key is available.
MOOTION_API_BASE=https://api.seedv.cn
MOOTION_API_TOKEN=

# NVIDIA. Empty values keep the local planner, the local load score, and text instead of voice.
# Jarvis. Mot d’éveil « jarvis », français. Pipeline écouter → penser → parler.
# AGENT_LLM_BASE_URL pointe vers ACE_LLM / llama.cpp (ex. http://localhost:8000/v1).
# RIVA_ASR_URL, ASR_SERVER_URL, RIVA_TTS_URL, TTS_SERVER_URL remplacent le micro et la voix du navigateur.
# OAuth — Relier ouvre la vraie fenêtre fournisseur (jamais de faux « connecté »).
# URI de callback : {ATLAS_OAUTH_ORIGIN}/api/atlas/oauth/callback
ATLAS_OAUTH_ORIGIN=https://atlast.strimetv.site
NEXT_PUBLIC_APP_URL=https://atlast.strimetv.site
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Clés API / bot tokens (Relier → formulaire si absentes)
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
STRIPE_SECRET_KEY=
FIGMA_ACCESS_TOKEN=
LINEAR_API_KEY=
GITLAB_TOKEN=
SHOPIFY_SHOP=
SHOPIFY_ADMIN_TOKEN=
X_BEARER_TOKEN=
DROPBOX_ACCESS_TOKEN=
PIPEDRIVE_API_TOKEN=
CANVA_API_TOKEN=

# MCP Gateway. URL hub (n8n MCP Server Trigger, Sema4…) pour Jira, CRM, Analytics, etc.
# Les secrets restent côté serveur ; jamais exposés au LLM.
ATLAS_MCP_HUB_URL=
ATLAS_MCP_N8N_URL=
ATLAS_MCP_GMAIL_URL=

# AMD Developer Cloud — chemin ADDITIF. La couche NVIDIA n’est pas remplacée.
# Sur une instance MI300X / MI355 : servir Nemotron 3 Super avec vLLM + ROCM_AITER_FA=1
# (voir tools/amd/serve-nemotron.sh). Sans ces variables, ATLAS reste sur NVIDIA.
AMD_VLLM_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_VLLM_MODEL=DeepSeek-V4.1-Flash
AMD_VLLM_API_KEY=
AMD_TOKENFACTORY_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_TOKENFACTORY_API_KEY=

# Google Gemma (prix partenaire optionnel) — même Token Factory, id catalogue.
AMD_GEMMA_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_GEMMA_MODEL=Gemma-4-31B-IT
AMD_MIN_TOKENS=768
AMD_TOKEN_BOOST=1.8
AMD_MIN_TIMEOUT_MS=32000

# Evolus (prix partenaire optionnel). Workspace événement : app.evolus.ai + code kickoff.
# L’agent Evolus doit pointer sur le vLLM AMD de l’équipe (pas NVIDIA).
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_AGENT_ID=
EVOLUS_LIBRARY_ID=
EVOLUS_WORKFLOW_ID=

# ZTC Hosting — lecture seule. Guest FOSSBilling + DEVOID health sont publics.
# Pont LLM : le site / DEVOID appelle POST /api/atlas/ztc/connect { op: think, desk, text }.
ZTC_CORE_API=
ZTC_FOSSBILLING_URL=https://ztchosting.com
ZTC_WHM_URL=
ZTC_DEVOID_URL=https://ztchosting.com/devoid-api
ZTC_DEVOID_TOKEN=
ZTC_BRIDGE_TOKEN=

NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# Image gen (FLUX.1-schnell cloud). Override si NIM local :
# NVIDIA_IMAGE_URL=http://localhost:8000/v1/infer
NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-schnell
AGENT_LLM_BASE_URL=http://localhost:8000/v1
AGENT_LLM_MODEL=qwen3-4b
NVIDIA_LLM_URL=http://localhost:8000/v1
NVIDIA_LLM_MODEL=qwen3-4b
ATLAS_LLM_GGUF=C:/Users/PC/Downloads/Qwen3-4B-Q4_K_M.gguf
ACE_LLM_PATH=C:/Users/PC/Downloads/ACE_LLM_5.5_v0.5/ACE_LLM_5.5_v0.5
ACE_ASR_ZIP=C:/Users/PC/Downloads/ACE_ASR_v5_5_1.0.4.zip
MAYA_ACE_REPO=https://github.com/NVIDIA/Maya-ACE
ASR_SERVER_URL=
TTS_SERVER_URL=
ASR_MODEL_NAME=
TTS_MODEL_NAME=nvidia/magpie-tts-multilingual
TTS_VOICE_ID=French-Female
RIVA_ASR_URL=
RIVA_TTS_URL=
RAPIDS_URL=
