FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
COPY connectors ./connectors
COPY apps/web/package.json ./apps/web/package.json
COPY apps/mobile/package.json ./apps/mobile/package.json
RUN npm ci

FROM deps AS build
COPY apps/web ./apps/web
COPY packages ./packages
ENV NEXT_TELEMETRY_DISABLED=1
# Public URLs baked for browser (can still override at runtime for server).
ARG NEXT_PUBLIC_APP_URL=https://atlast.strimetv.site
ARG NEXT_PUBLIC_ATLAS_GATEWAY_URL=https://atlast.strimetv.site
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_ATLAS_GATEWAY_URL=$NEXT_PUBLIC_ATLAS_GATEWAY_URL
RUN npm run build --workspace @atlas/web

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json /app/package-lock.json /app/tsconfig.base.json ./
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/services ./services
COPY --from=deps /app/connectors ./connectors
COPY --from=build /app/apps/web ./apps/web
EXPOSE 3000
CMD ["npm", "run", "start", "--workspace", "@atlas/web"]
